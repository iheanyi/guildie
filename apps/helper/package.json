{
  "name": "@guildie/helper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts --console",
    "build:win": "bun build src/main.ts --compile --minify --target=bun-windows-x64 --windows-hide-console --windows-icon=assets/guildie.ico --windows-title=guildie --windows-publisher=guildie --windows-description=\"guildie helper\" --windows-version=0.2.0.0 --outfile dist/guildie-helper.exe",
    "build:mac": "bun build src/main.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/guildie-helper",
    "check": "tsc --noEmit",
    "test": "bun test ../../packages/sync/src",
    "icon": "python3 scripts/make-icon.py",
    "build:win-cross": "bun build src/main.ts --compile --minify --target=bun-windows-x64 --outfile dist/guildie-helper.exe && bun scripts/windows-gui-subsystem.ts dist/guildie-helper.exe"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@guildie/sync": "workspace:*"
  }
}
