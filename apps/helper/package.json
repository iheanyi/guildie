{
	"name": "@guildie/helper",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun src/main.ts",
		"build:win": "bun build src/main.ts --compile --minify --target=bun-windows-x64 --outfile dist/guildie-helper.exe",
		"build:mac": "bun build src/main.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/guildie-helper",
		"check": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@types/bun": "^1.3.9",
		"typescript": "^5.9.3"
	}
}
