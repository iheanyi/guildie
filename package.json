{
  "name": "guildie",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @guildie/web dev",
    "build": "pnpm --filter @guildie/web build",
    "check": "pnpm -r check",
    "test": "pnpm -r --if-present test",
    "seed": "pnpm --filter @guildie/web seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "patchedDependencies": {
      "@convex-dev/auth": "patches/@convex-dev__auth.patch"
    }
  }
}
