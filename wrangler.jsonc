{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "guildies",
	"account_id": "fc87b44f5832b25053fec2efb19fc208",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "guildie.club", "zone_name": "guildie.club", "custom_domain": true },
		// Branch previews at <branch>.preview.guildie.club; serves no production traffic.
		{
			"pattern": "preview.guildie.club",
			"zone_name": "guildie.club",
			"custom_domain": true,
			"previews_enabled": true,
			"enabled": false
		}
	],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": true }
	},
	// The Convex URLs are baked in at build (VITE_*). The Worker has no runtime
	// secrets: Blizzard calls and syncs run in Convex. See docs/deploy.md.
	"previews": {
		"observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } }
	}
}
